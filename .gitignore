# Plaintext card data — NEVER publish
cards.md
cards.html

# Churning build tooling.
# build.py is committed on purpose: it holds no secrets (the password comes
# from the CHURNING_PASSWORD env var / prompt, and the salt + algorithm are
# already public in churning.html), and it lets the page be edited from any
# checkout — including Claude Code on mobile — without needing a local machine.
publish.sh

# Encryption password (only on local disk, never committed)
.churning_password

# staticrypt salt — regenerated per publish
.staticrypt.json

